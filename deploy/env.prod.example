# Business OS Production Environment Variables Example
# Master Plan Section 43 & 45

APP_RELEASE_VERSION=0.1.0
NODE_ENV=production
DOCKER_REGISTRY=ghcr.io/business-os

# PostgreSQL Configuration (Admin / Migrator)
POSTGRES_USER=business_os_admin
POSTGRES_PASSWORD=ChangeThisToAStrongGeneratedSecretPassword2026!
POSTGRES_DB=business_os_prod

# Runtime Least-Privilege Database Credentials (DML-only, NOBYPASSRLS)
APP_DB_USER=app_user
APP_DB_PASSWORD=ChangeThisToAStrongRuntimeAppSecretPassword2026!

# Runtime Application Connection (used strictly by app and worker services for DML; least-privilege app_user)
DATABASE_URL=postgres://app_user:ChangeThisToAStrongRuntimeAppSecretPassword2026!@postgres:5432/business_os_prod

# Administrative / Migrator Connection (used strictly by schema migrations, role provisioning, and DDL commands)
# In production (NODE_ENV=production), MIGRATOR_DATABASE_URL is strictly required and fails closed if absent.
MIGRATOR_DATABASE_URL=postgres://business_os_admin:ChangeThisToAStrongGeneratedSecretPassword2026!@postgres:5432/business_os_prod

# Redis Configuration
REDIS_PASSWORD=ChangeThisToAStrongRedisPassword2026!

# S3 / MinIO Object Storage Configuration
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=business_os_s3_key
S3_SECRET_KEY=ChangeThisToAStrongS3SecretKey2026!
S3_BUCKET=business-os-storage

# Authentication & Security
JWT_SECRET=ChangeThisToAStrong64CharRandomHexSecretString2026!
ENCRYPTION_KEY=ChangeThisToA32ByteKeyForWebhookSignatures2026!

# Meta Lead Ads & WhatsApp Cloud API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_token
