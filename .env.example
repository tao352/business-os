# ==============================================================================
# BUSINESS OS - ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env for local development
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database (PostgreSQL 16 + pgvector)
# For local Docker: postgres://postgres:postgres@localhost:5432/business_os
DATABASE_URL=postgres://postgres:postgres@localhost:5432/business_os
DATABASE_MAX_CONNECTIONS=20

# Cache & Message Broker (Redis 7)
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO local / S3 production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=business-os-storage
S3_FORCE_PATH_STYLE=true

# AI Gateway (LiteLLM / Direct Providers)
LITELLM_URL=http://localhost:8000
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Integrations (Meta & WhatsApp)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=local-dev-verify-token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Security & Secrets
JWT_SECRET=super-secret-jwt-signing-key-minimum-32-chars-for-dev
SUPERADMIN_EMAILS=owner@business-os.local
